# Google Maps API key for address autocomplete (Places API + Maps JavaScript API).
# Optional — if unset, the app falls back to free OpenStreetMap/Nominatim suggestions.
# This is a *browser* key: it ships in the client bundle, so restrict it in
# Google Cloud Console by HTTP referrer and to the Places/Maps JS APIs only.
# Copy this file to `.env.local` and fill in your key.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Google "Vector" Map ID (Cloud Console → Map Management).
# Enables the tilted, heading-up 3D driving camera during navigation.
# Without it, navigation still follows you (zoomed, north-up).
VITE_GOOGLE_MAP_ID=
